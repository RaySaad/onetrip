<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_account_statement_wizard_form" model="ir.ui.view">
        <field name="name">vehicle.account.statement.wizard.form</field>
        <field name="model">vehicle.account.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Vehicle Account Statement">
                <group>
                    <group><field name="vehicle_id"/><field name="company_id" groups="base.group_multi_company"/></group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                </group>
                <group string="Options">
                    <field name="posted_only"/><field name="include_service_history"/><field name="include_depreciation_schedule"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="PDF" type="object" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_vehicle_account_statement_wizard" model="ir.actions.act_window">
        <field name="name">Vehicle Account Statement</field><field name="res_model">vehicle.account.statement.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
    <menuitem id="menu_vehicle_account_statement" name="Vehicle Account Statement" parent="fleet_expenses.menu_fleet_expense_reporting" action="action_vehicle_account_statement_wizard" sequence="20" groups="hr_expense.group_hr_expense_user"/>
</odoo>
