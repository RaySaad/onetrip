<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_account_statement_wizard_form" model="ir.ui.view">
        <field name="name">employee.account.statement.wizard.form</field>
        <field name="model">employee.account.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Statement">
                <sheet>
                    <div class="oe_title">
                        <h1>Employee Statement</h1>
                    </div>
                    <group>
                        <group string="Employee Information">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="employee_id"
                                   context="{'account_employee_lookup': True, 'company_id': company_id}"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   placeholder="Search by employee name or IQAMA / ID number..."/>
                            <field name="account_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group string="Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <div class="o_form_label text-muted">Only posted journal items are included.</div>
                        </group>
                    </group>
                    <field name="excel_file" invisible="1"/>
                    <field name="excel_filename" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_print_pdf" type="object" string="Export PDF" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_account_statement_wizard" model="ir.actions.act_window">
        <field name="name">Employee Statement</field>
        <field name="res_model">employee.account.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_account_statement_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- Directly under Accounting > Reporting, as requested. -->
    <menuitem id="menu_employee_account_statement"
              name="Employee Statement"
              parent="account.menu_finance_reports"
              action="action_employee_account_statement_wizard"
              sequence="15"
              groups="account.group_account_readonly"/>
</odoo>
