<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone Accounting > Journal Items list. -->
    <record id="view_move_line_list_employee" model="ir.ui.view">
        <field name="name">account.move.line.list.employee</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='partner_id']" position="after">
                <field name="employee_id"
                       optional="show"
                       context="{'account_employee_lookup': True, 'company_id': company_id}"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Journal Item form opened from the list. -->
    <record id="view_move_line_form_employee" model="ir.ui.view">
        <field name="name">account.move.line.form.employee</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="employee_id"
                       context="{'account_employee_lookup': True, 'company_id': company_id}"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Journal Entry form > Journal Items tab. -->
    <record id="view_move_form_employee_on_journal_items" model="ir.ui.view">
        <field name="name">account.move.form.employee.journal.items</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='aml_tab']/field[@name='line_ids']/list/field[@name='partner_id']" position="after">
                <field name="employee_id"
                       optional="show"
                       context="{'account_employee_lookup': True, 'company_id': company_id}"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Search and Group By support in Journal Items. -->
    <record id="view_account_move_line_filter_employee" model="ir.ui.view">
        <field name="name">account.move.line.search.employee</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='partner_id']" position="after">
                <field name="employee_id"
                       context="{'account_employee_lookup': True}"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//search/group/filter[@name='group_by_partner']" position="after">
                <filter string="Employee" name="group_by_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
